generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ROLE & USER MANAGEMENT
// ============================================

enum Role {
  ADMIN
  KASIR
  TEKNISI
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  password        String
  fullName        String
  role            Role      @default(KASIR)
  isActive        Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  
  // Relations
  sales           Sale[]
  payments        Payment[]
  serviceOrders   ServiceOrder[]
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  
  @@index([username])
  @@index([role])
}

// ============================================
// CUSTOMER MANAGEMENT
// ============================================

model Customer {
  id              String   @id @default(uuid())
  name            String
  phone           String?
  email           String?
  address         String?
  notes           String?
  totalTransactions Int    @default(0)
  totalReceivable Int      @default(0) // In Rupiah
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  sales           Sale[]
  serviceOrders   ServiceOrder[]
  receivables     AccountReceivable[]
  
  @@index([phone])
  @@index([name])
}

// ============================================
// SUPPLIER MANAGEMENT
// ============================================

model Supplier {
  id              String   @id @default(uuid())
  name            String
  contact         String?
  phone           String?
  email           String?
  address         String?
  notes           String?
  totalPayable    Int      @default(0) // In Rupiah
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  purchases       Purchase[]
  payables        SupplierPayable[]
  
  @@index([phone])
  @@index([name])
}

// ============================================
// TECHNICIAN MANAGEMENT
// ============================================

model Technician {
  id              String   @id @default(uuid())
  name            String
  phone           String?
  email           String?
  address         String?
  specialty       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  serviceOrders   ServiceOrder[]
  
  @@index([name])
}

// ============================================
// PRODUCT & INVENTORY
// ============================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  products    Product[]
  
  @@index([name])
}

model Product {
  id              String   @id @default(uuid())
  code            String   @unique
  barcode         String?  @unique
  name            String
  categoryId      String?
  brand           String?
  unit            String   @default("PCS")
  description     String?
  buyPrice        Int      @default(0) // In Rupiah
  sellPrice       Int      @default(0) // In Rupiah
  stock           Int      @default(0)
  minStock        Int      @default(5)
  location        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  category        Category? @relation(fields: [categoryId], references: [id])
  stockMovements  StockMovement[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  serviceItems    ServiceItem[]
  
  @@index([code])
  @@index([barcode])
  @@index([name])
  @@index([categoryId])
}

model StockMovement {
  id              String   @id @default(uuid())
  productId       String
  type            String   // IN, OUT, ADJUSTMENT, SALE, PURCHASE, SERVICE_USE
  quantity        Int
  previousStock   Int
  newStock        Int
  referenceType   String?  // SALE, PURCHASE, SERVICE, ADJUSTMENT
  referenceId     String?
  notes           String?
  userId          String
  createdAt       DateTime @default(now())
  
  // Relations
  product         Product  @relation(fields: [productId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  
  @@index([productId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// ============================================
// PURCHASE FROM SUPPLIER
// ============================================

model Purchase {
  id              String   @id @default(uuid())
  number          String   @unique
  supplierId      String
  purchaseDate    DateTime @default(now())
  subtotal        Int      @default(0)
  discount        Int      @default(0)
  otherCosts      Int      @default(0)
  total           Int      @default(0)
  paidAmount      Int      @default(0)
  remainingAmount Int      @default(0)
  dueDate         DateTime?
  notes           String?
  status          String   @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  paymentStatus   String   @default("UNPAID") // UNPAID, PARTIAL, PAID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?
  
  // Relations
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]
  payables        SupplierPayable[]
  payments        Payment[]
  
  @@index([number])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
}

model PurchaseItem {
  id              String   @id @default(uuid())
  purchaseId      String
  productId       String
  quantity        Int
  buyPrice        Int      // Snapshot price
  discount        Int      @default(0)
  subtotal        Int      @default(0)
  createdAt       DateTime @default(now())
  
  // Relations
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  
  @@index([purchaseId])
  @@index([productId])
}

// ============================================
// SALES / POS
// ============================================

model Sale {
  id              String   @id @default(uuid())
  number          String   @unique
  customerId      String?
  serviceOrderId  String?  @unique // Link to service order if combined - one-to-one relation
  saleDate        DateTime @default(now())
  subtotal        Int      @default(0)
  discount        Int      @default(0)
  taxRate         Float    @default(0)
  taxAmount       Int      @default(0)
  total           Int      @default(0)
  paidAmount      Int      @default(0)
  remainingAmount Int      @default(0)
  notes           String?
  status          String   @default("DRAFT") // DRAFT, COMPLETED, CANCELLED
  paymentStatus   String   @default("UNPAID") // UNPAID, DP, PAID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?
  
  // Relations
  customer        Customer? @relation(fields: [customerId], references: [id])
  serviceOrder    ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  receivables     AccountReceivable[]
  payments        Payment[]
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  
  @@index([number])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
  @@index([userId])
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String
  itemType        String   // PRODUCT, SERVICE, MANUAL
  productId       String?
  name            String   // Snapshot name
  price           Int      // Snapshot price
  quantity        Int      @default(1)
  discount        Int      @default(0)
  subtotal        Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  
  // Relations
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id])
  
  @@index([saleId])
  @@index([productId])
}

// ============================================
// SERVICE ORDER
// ============================================

enum ServiceStatus {
  DITERIMA
  PEMERIKSAAN
  MENUNGGU_PERSETUJUAN
  MENUNGGU_SPAREPART
  DALAM_PENGERJAAN
  SELESAI
  SUDAH_DIAMBIL
  DIBATALKAN
  TIDAK_JADI_DIPERBAIKI
}

model ServiceOrder {
  id                  String        @id @default(uuid())
  number              String        @unique
  customerId          String?
  customerName        String
  customerPhone       String?
  customerAddress     String?
  deviceType          String
  deviceBrand         String
  deviceModel         String?
  serialNumber        String?
  complaint           String
  physicalCondition   String?
  accessories         String?
  photos              String?      // JSON array of photo URLs
  technicianId        String?
  estimatedCost       Int          @default(0)
  dpAmount            Int          @default(0)
  totalCost           Int          @default(0)
  remainingAmount     Int          @default(0)
  examinationResult   String?
  repairAction        String?
  technicianNotes     String?
  warrantyDays        Int          @default(0)
  generalNotes        String?
  status              ServiceStatus @default(DITERIMA)
  paymentStatus       String        @default("UNPAID") // UNPAID, DP, PAID
  receivedAt          DateTime      @default(now())
  estimatedFinish     DateTime?
  finishedAt          DateTime?
  pickedUpAt          DateTime?
  pickedUpBy          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Relations
  customer            Customer?     @relation(fields: [customerId], references: [id])
  technician          Technician?   @relation(fields: [technicianId], references: [id])
  items               ServiceItem[]
  receivables         AccountReceivable[]
  payments            Payment[]
  sale                Sale?
  user                User          @relation(fields: [userId], references: [id])
  userId              String
  
  @@index([number])
  @@index([customerId])
  @@index([status])
  @@index([technicianId])
  @@index([receivedAt])
}

model ServiceItem {
  id              String   @id @default(uuid())
  serviceOrderId  String
  itemType        String   // SPAREPART, SERVICE_JOB, MANUAL
  productId       String?
  name            String   // Snapshot name
  price           Int      // Snapshot price
  quantity        Int      @default(1)
  discount        Int      @default(0)
  subtotal        Int      @default(0)
  notes           String?
  isUsed          Boolean  @default(false) // For spareparts, true when actually used
  createdAt       DateTime @default(now())
  
  // Relations
  serviceOrder      ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product           Product?   @relation(fields: [productId], references: [id])
  
  @@index([serviceOrderId])
  @@index([productId])
}

// ============================================
// PAYMENTS
// ============================================

enum PaymentMethod {
  TUNAI
  TRANSFER
  QRIS
  DEBIT
  KREDIT
  LAINNYA
}

model Payment {
  id              String        @id @default(uuid())
  number          String        @unique
  transactionType String        // SALE, SERVICE, PURCHASE
  transactionId   String
  amount          Int
  method          PaymentMethod
  notes           String?
  paymentDate     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  
  // Relations
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])
  sale            Sale?         @relation(fields: [saleId], references: [id])
  serviceOrder    ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  
  // Foreign keys for polymorphic relation
  purchaseId      String?
  saleId          String?
  serviceOrderId  String?
  
  @@index([transactionType, transactionId])
  @@index([paymentDate])
  @@index([userId])
}

// ============================================
// ACCOUNTS RECEIVABLE (Customer Debts)
// ============================================

model AccountReceivable {
  id              String   @id @default(uuid())
  customerId      String
  saleId          String?
  serviceOrderId  String?
  amount          Int
  paidAmount      Int      @default(0)
  remainingAmount Int
  dueDate         DateTime?
  notes           String?
  status          String   @default("OPEN") // OPEN, PAID, OVERDUE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  customer        Customer   @relation(fields: [customerId], references: [id])
  sale            Sale?      @relation(fields: [saleId], references: [id], onDelete: SetNull)
  serviceOrder    ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

// ============================================
// SUPPLIER PAYABLES
// ============================================

model SupplierPayable {
  id              String   @id @default(uuid())
  supplierId      String
  purchaseId      String?
  amount          Int
  paidAmount      Int      @default(0)
  remainingAmount Int
  dueDate         DateTime?
  notes           String?
  status          String   @default("OPEN") // OPEN, PAID, OVERDUE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  purchase        Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String   // JSON string for complex values
  description     String?
  updatedAt       DateTime @updatedAt
  
  @@index([key])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  action          String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, SYNC, etc.
  entityType      String   // USER, PRODUCT, SALE, SERVICE, etc.
  entityId        String?
  oldValue        String?  // JSON
  newValue        String?  // JSON
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  
  // Relations
  user            User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// SYNC RECORDS (for offline-first)
// ============================================

model SyncRecord {
  id              String   @id @default(uuid())
  deviceId        String
  entityType      String
  entityId        String
  operation       String   // CREATE, UPDATE, DELETE
  data            String   // JSON
  syncStatus      String   @default("PENDING") // PENDING, SYNCED, FAILED
  syncedAt        DateTime?
  errorMessage    String?
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([deviceId])
  @@index([syncStatus])
  @@index([entityType, entityId])
  @@index([createdAt])
}
